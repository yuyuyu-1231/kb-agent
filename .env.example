# ============================================================
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会入库。
# ============================================================

# ---- LLM ----
# 注意：DeepSeek 官方模型名为 deepseek-chat / deepseek-reasoner
#       Function Calling 必须用 deepseek-chat（reasoner 早期不支持 tools）
#       第 2 周会用 GET /models 实测校验，勿直接照抄历史值
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# ---- Embedding ----
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
# BGE 中文模型 query 侧必须加此前缀，passage 侧不加
EMBED_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ---- 分块 ----
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---- Agent 内核 ----
# 上下文总预算（token）
TOKEN_BUDGET=30000
# 单次 run 最大轮数
MAX_STEPS=6
# 估算系数：中文字符 × 1.0 + 其他字符 × 0.3，评估阶段用真实 usage 校准
TOKEN_ESTIMATE_CN=1.0
TOKEN_ESTIMATE_OTHER=0.3
# 单工具超时（秒）
TOOL_TIMEOUT=30
# 单个工具结果字符上限，超出截断并打标记
TOOL_RESULT_MAX_CHARS=2000

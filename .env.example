# ============================================================
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会入库。
# ============================================================

# ---- LLM ----
# 2026-11-04 实测：GET /models 返回 deepseek-flash 与 deepseek-v4-pro
# deepseek-flash 已验证支持 Function Calling（含一次返回多个 tool_calls）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# ---- Embedding ----
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
# BGE 中文模型 query 侧必须加此前缀，passage 侧不加
EMBED_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ---- 分块 ----
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---- Agent 内核 ----
# 上下文总预算（token）
TOKEN_BUDGET=30000
# 单次 run 最大轮数
MAX_STEPS=6
# 估算系数：中文字符 × 1.0 + 其他字符 × 0.3，评估阶段用真实 usage 校准
TOKEN_ESTIMATE_CN=1.0
TOKEN_ESTIMATE_OTHER=0.3
# 单工具超时（秒）
TOOL_TIMEOUT=30
# 单个工具结果字符上限，超出截断并打标记
TOOL_RESULT_MAX_CHARS=2000

# ---- 访问控制（仅公网部署需要）----
# 留空 = 不鉴权。本地开发保持空，测试也不受影响。
# 部署到公网前**必须**填一个长随机串，否则 /qa/ask 背后的 LLM key
# 会被人刷（按量计费，账单不可控）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 前端在页面右上角的输入框里填同一个值，存 localStorage。
ACCESS_TOKEN=
# 每 IP 每分钟请求上限（只在 ACCESS_TOKEN 非空时生效）
RATE_LIMIT_PER_MINUTE=60

# ---- 数据库后端 ----
# sqlite（默认，本地开发与测试）| mysql（部署）
#
# 切到 mysql 之前先确认：`docker compose up -d mysql` 已经起好，
# 且下面的 MYSQL_* 与实际容器一致。
# 切回去只需把 DB_BACKEND 改回 sqlite，两边的数据是分开的。
DB_BACKEND=sqlite

# MySQL 连接参数（DB_BACKEND=mysql 时才读）
# 注意：容器里 MYSQL_HOST 必须是服务名 mysql，不能写 localhost
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=kb
MYSQL_PASSWORD=kbpass
MYSQL_DATABASE=kb_agent
# 连接池大小与获取超时（秒）
MYSQL_POOL_SIZE=5
MYSQL_ACQUIRE_TIMEOUT=3.0
